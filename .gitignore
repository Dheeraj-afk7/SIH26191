# ─── Node / React ────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── GIS / Large Data ────────────────────────────────────────────────────────
# Raw rasters and shapefiles can be large — exclude binary blobs from version control.
# (Check in metadata/README files only, not the actual datasets.)
data/raw/
data/processed/
data/outputs/
*.tif
*.tiff
*.geotiff
*.img
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.qix
*.gpkg
*.gdb/
*.mbtiles
*.pbf
*.nc
*.hdf
*.h5

# ─── OS & IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*~

# ─── Secrets / Config ────────────────────────────────────────────────────────
configs/secrets.yaml
configs/*.key
*.pem
