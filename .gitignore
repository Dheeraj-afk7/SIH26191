# ─── Node / React ────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.cache/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── GIS / Large Data ────────────────────────────────────────────────────────
# Ignore raw datasets and large intermediate rasters
data/raw/**
data/processed/hazards/**
data/processed/hydrology/**
data/processed/sites/**
data/processed/terrain/**

*.tif
*.tiff
*.geotiff
*.img
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.qix
*.gdb/
*.mbtiles
*.pbf
*.nc
*.hdf
*.h5

# Keep directory structure & documentation
!data/**/
!data/**/README.md
!data/**/.gitkeep

# Explicitly track API runtime datasets (decision support outputs & candidate layers)
!data/processed/decision/**
!data/processed/decision/*.gpkg
!data/processed/exposure/**
!data/processed/habitations/**
!data/processed/infrastructure/**
!data/processed/disaster_history/**
!data/processed/roads/**
!data/processed/lulc/**
!data/outputs/**
!data/outputs/*.gpkg
!data/raw/roads/provenance_metadata.json
!data/raw/disaster_history/provenance_metadata.json
!data/raw/disaster_history/*.json

# ─── OS & IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*~

# ─── Secrets / Config ────────────────────────────────────────────────────────
configs/secrets.yaml
configs/*.key
*.pem

# ─── Internal / Dev-Only Files (not for reviewers) ──────────────────────────
# AI-generated knowledge base — internal use only
SIH-KNOWLEDGE-BASE/

# Scratch / debug scripts
scripts/scratch_*.py

# Raw step-log development notes inside docs/
docs/step8_*.md
docs/step9_*.md
docs/step10_*.md
docs/step11_*.md
docs/post_step*.md

# Root-level duplicates (canonical copy lives in docs/)
PROJECT_FORENSIC_AUDIT.md
