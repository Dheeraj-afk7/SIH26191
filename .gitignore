# ─── GIS / Large Data ────────────────────────────────────────────────────────
# Ignore all content inside data/ subdirectories (large binary datasets),
# but keep README.md files so directory intent is documented in Git.
# NOTE: Must ignore contents (data/raw/**) not the directory itself (data/raw/)
# so that the README.md exemption below can work correctly.
data/raw/**
!data/raw/README.md
data/processed/**
!data/processed/README.md
data/outputs/**
!data/outputs/README.md
*.tif
*.tiff
*.geotiff
*.img
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.qix
*.gpkg
*.gdb/
*.mbtiles
*.pbf
*.nc
*.hdf
*.h5

# ─── OS & IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*~

# ─── Secrets / Config ────────────────────────────────────────────────────────
configs/secrets.yaml
configs/*.key
*.pem
