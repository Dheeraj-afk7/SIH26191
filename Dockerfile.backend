# Python + Geospatial base image
FROM python:3.11-slim

# Install system GDAL, C/C++ build tools and spatial libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source, configs, and required decision data
COPY backend/ backend/
COPY configs/ configs/
COPY data/processed/decision/ data/processed/decision/
COPY data/outputs/ data/outputs/

EXPOSE 8000

# Run FastAPI backend with Uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
